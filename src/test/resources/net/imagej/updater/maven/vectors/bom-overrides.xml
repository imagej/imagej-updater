<?xml version="1.0" encoding="UTF-8"?>
<mediation-vector name="bom-overrides">
  <description>
    The BOM manages lib:util at 2.5 while extensions request 2.4 and 2.6.
    The BOM wins over MVS in both directions; holding below the 2.6
    request fires held-below (same major, so no misalignment warning).
  </description>
  <catalog>
    <component coordinate="ex:alpha">
      <release version="1">
        <dependency coordinate="lib:util:2.4"/>
      </release>
    </component>
    <component coordinate="ex:beta">
      <release version="1">
        <dependency coordinate="lib:util:2.6"/>
      </release>
    </component>
    <component coordinate="lib:util">
      <release version="2.4"/>
      <release version="2.5"/>
      <release version="2.6"/>
    </component>
    <managed bom="ex:bom:1">
      <version coordinate="lib:util:2.5"/>
    </managed>
  </catalog>
  <roots>
    <root coordinate="ex:alpha:1"/>
    <root coordinate="ex:beta:1"/>
  </roots>
  <expected>
    <select coordinate="ex:alpha:1"/>
    <select coordinate="ex:beta:1"/>
    <select coordinate="lib:util:2.5"/>
    <warning type="held-below" coordinate="lib:util"/>
  </expected>
</mediation-vector>
