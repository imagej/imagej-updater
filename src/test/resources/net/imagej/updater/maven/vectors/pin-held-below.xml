<?xml version="1.0" encoding="UTF-8"?>
<mediation-vector name="pin-held-below">
  <description>
    User pins honey at 1 (a downgrade) while toast requests honey:2. The
    pin wins; honey's subtree resolves at version 1 (bee:1); held-below
    and major-misalignment warnings both fire for honey.
  </description>
  <catalog>
    <component coordinate="brk:toast">
      <release version="1">
        <dependency coordinate="brk:honey:2"/>
      </release>
    </component>
    <component coordinate="brk:honey">
      <release version="1">
        <dependency coordinate="brk:bee:1"/>
      </release>
      <release version="2">
        <dependency coordinate="brk:bee:2"/>
      </release>
    </component>
    <component coordinate="brk:bee">
      <release version="1"/>
      <release version="2"/>
    </component>
  </catalog>
  <roots>
    <root coordinate="brk:toast:1"/>
    <root coordinate="brk:honey:1" pinned="true"/>
  </roots>
  <expected>
    <select coordinate="brk:toast:1"/>
    <select coordinate="brk:honey:1"/>
    <select coordinate="brk:bee:1"/>
    <warning type="held-below" coordinate="brk:honey"/>
    <warning type="major-misalignment" coordinate="brk:honey"/>
  </expected>
</mediation-vector>
