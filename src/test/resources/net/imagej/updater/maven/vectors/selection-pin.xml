<?xml version="1.0" encoding="UTF-8"?>
<mediation-vector name="selection-pin">
  <description>
    A user pin overrides even the site's own selection: the site ships
    log:2, the user pins log:1, and held-below plus major-misalignment
    warnings fire.
  </description>
  <catalog>
    <component coordinate="app:fiji" offered="true" current="1">
      <release version="1">
        <selection>
          <select coordinate="app:fiji:1"/>
          <select coordinate="lib:log:2"/>
        </selection>
        <dependency coordinate="lib:log:2"/>
      </release>
    </component>
    <component coordinate="lib:log">
      <release version="1"/>
      <release version="2"/>
    </component>
  </catalog>
  <roots>
    <root coordinate="app:fiji:1"/>
    <root coordinate="lib:log:1" pinned="true"/>
  </roots>
  <expected>
    <select coordinate="app:fiji:1"/>
    <select coordinate="lib:log:1"/>
    <warning type="held-below" coordinate="lib:log"/>
    <warning type="major-misalignment" coordinate="lib:log"/>
  </expected>
</mediation-vector>
